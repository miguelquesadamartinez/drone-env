# Copia este archivo a ".env" y ajusta los valores segun donde ejecutes el servidor.

# Conexion al vehiculo (Pixhawk).
# En tu PC contra SITL: udp:127.0.0.1:14551
# En la Raspberry con la UART real: /dev/serial0:921600
DRONE_CONN=/dev/serial0:921600

# Segundos sin recibir /ping (con el dron armado) antes de disparar RTL automatico.
DRONE_WATCHDOG_TIMEOUT=5
